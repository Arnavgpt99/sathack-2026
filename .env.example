# ==============================================================================
# REELIX — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and configure your credentials.
# Command: cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AUTH.JS (NEXTAUTH v5) CONFIGURATION
# ------------------------------------------------------------------------------
# Generate a secure secret using: openssl rand -base64 32
# or run: npx auth secret
AUTH_SECRET="your-32-character-secret-key-here"

# Canonical URL for NextAuth (required for local redirects and callbacks)
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH 2.0 CREDENTIALS
# ------------------------------------------------------------------------------
# Obtain these from Google Cloud Console (https://console.cloud.google.com/):
#
# 1. Create a project in Google Cloud Console.
# 2. Navigate to "APIs & Services" > "OAuth consent screen" and configure it:
#    - User Type: External
#    - App Name: Reelix Studio
#    - Scopes: email, profile, openid
# 3. Navigate to "Credentials" > "Create Credentials" > "OAuth Client ID":
#    - Application type: Web application
#    - Name: Reelix Local Dev
#    - Authorized JavaScript origins:
#      http://localhost:3000
#    - Authorized redirect URIs:
#      http://localhost:3000/api/auth/callback/google
#
# 4. Paste your Client ID and Client Secret below:
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 3. REELIX BACKEND & LOCAL DEMO OVERRIDES
# ------------------------------------------------------------------------------
# Backend microservice URL (defaults to http://127.0.0.1:8000)
REELIX_BACKEND_URL="http://127.0.0.1:8000"

# Optional shared secret sent in X-Reelix-Key header (matches REELIX_BACKEND_KEY in backend/.env)
# REELIX_BACKEND_KEY="your-shared-backend-secret"

# Require user session to call /api/analyze and Gemini AI microservice.
# Set to "false" to allow local testing and hackathon demo runs without configuring Google OAuth.
REELIX_REQUIRE_AUTH="false"
