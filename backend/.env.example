# Reelix backend. Copy to .env and export, or set in your shell. Never commit the real file.

# Gemini Developer API key (AI Studio). NOT a Google Cloud / Vertex credential.
GEMINI_API_KEY=
# Model id to use. Look up a current video-capable model in the Gemini docs and paste it here;
# it is intentionally not hardcoded because model names change.
GEMINI_MODEL=

# Shared secret the Next.js proxy sends as X-Reelix-Key. Must match REELIX_BACKEND_KEY in the frontend .env.local.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REELIX_BACKEND_KEY=

# Optional
ALLOWED_ORIGINS=http://localhost:3000
GEMINI_TIMEOUT_SEC=900
MAX_JOBS=200
MAX_WORKERS=2
MAX_CLIPS=6
JOB_TTL_SEC=3600
CACHE_TTL_SEC=3600
